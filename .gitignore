.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Local corpus (LanceDB store, downloaded PDFs, discovery lists)
data/

# Run logs
*.log
